# Port used by the Express server
PORT=3000

# Secret used to sign session cookies.
# Replace this with a long, random, secure string in production.
SESSION_SECRET=change_this_to_a_secure_random_string

# Application environment.
# Valid values:
# development - Uses SQLite by default for local development.
# production  - Uses PostgreSQL via DATABASE_URL.
NODE_ENV=development

# PostgreSQL connection string.
# Required when deploying in production.
# SQLite is used by default during local development.
#
# Example:
# postgres://username:password@host:5432/database_name
DATABASE_URL=